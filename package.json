{
  "name": "a-world-made-just-for-her",
  "private": true,
  "version": "1.0.0",
  "description": "A World Made Just For Her — The Princess & Her Royal Companion. An interactive romantic fantasy birthday adventure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "build:pages": "tsc -b && vite build --base /game-for-bday-sarah/",
    "proxy:bundle": "node scripts/build-worker.mjs",
    "proxy:check": "node scripts/build-worker.mjs --check",
    "content:accept": "node scripts/accept-content.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "7.18.6",
    "three": "0.180.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "playwright-core": "1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
